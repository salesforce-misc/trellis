# frozen_string_literal: true

require "rake/testtask"
require "rubygems/package_task"
require "rb_sys/extensiontask"

GEMSPEC = Gem::Specification.load(File.expand_path("trellis-pg.gemspec", __dir__))

# `rake gem`: the source gem, into pkg/.
Gem::PackageTask.new(GEMSPEC).define

# `rake compile` builds the extension with ext/trellis_ruby/extconf.rb, the
# same way installing the source gem does, and copies it into lib/trellis/.
# Cargo builds into the workspace's target/, so the build shares the
# dependencies every other workspace build has already compiled.
# `rake compile:dev` builds the dev profile instead of release.
#
# `rake native:<platform> gem` builds a platform gem. rb-sys-dock runs it
# inside its cross-compiling containers, once per platform, with every Ruby
# minor version in RUBY_CC_VERSION (.github/scripts/build-ruby-gem.sh).
RbSys::ExtensionTask.new("trellis_ruby", GEMSPEC) do |ext|
  ext.lib_dir = "lib/trellis"
end

Rake::TestTask.new(:test) do |t|
  t.libs << "test"
  t.test_files = FileList["test/**/*_test.rb"]
  t.warning = true
end
# The dev profile: a debug build is quicker to compile, and it's what the
# tests have always run against.
task test: "compile:dev"

task default: :test
