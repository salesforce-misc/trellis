#!/usr/bin/env bash
# Prove two migration sets produce the same catalog schema and seed data.
#
#   migration-diff <old-migrations-dir> [<new-migrations-dir>]
#
# Applies each set (files in `sort -V` order, one transaction per file, the
# schema on the search_path as the pool sets it) into scratch schemas of two
# names -- a short one and a 59-byte one, which exercises the work-wake channel
# truncation -- on a throwaway PG 17 cluster under target/, dumps schema and
# data, normalises, and prints EQUIVALENT or the diff. Exit 0 on equivalent.
#
# Env: PGBIN (default ~/.asdf/installs/postgres/17.11/bin), MD_KEEP=1 keeps the
# cluster running, MD_NEGATIVE=1 mutates one literal in the new set's
# seg_0_op_check first (the diff must then be non-empty).
set -euo pipefail
old=$(readlink -f "${1:?usage: migration-diff <old-dir> [<new-dir>]}")
root=$(git rev-parse --show-toplevel)
new=$(readlink -f "${2:-$root/trellis/migrations}")
PGBIN=${PGBIN:-$HOME/.asdf/installs/postgres/17.11/bin}
work=$root/target/migration-diff
port=${MD_PORT:-54899}
rm -rf "$work/data" "$work/out"; mkdir -p "$work/out" "$work/sock"
"$PGBIN/initdb" -D "$work/data" -U postgres --no-sync -A trust >/dev/null
"$PGBIN/pg_ctl" -D "$work/data" -o "-p $port -k $work/sock -c listen_addresses='' -c fsync=off" -l "$work/pg.log" -w start >/dev/null
cleanup() { [ -n "${MD_KEEP:-}" ] || { "$PGBIN/pg_ctl" -D "$work/data" -m immediate stop >/dev/null 2>&1 || true; rm -rf "$work/data" "$work/sock"; }; }
trap cleanup EXIT
psql_() { "$PGBIN/psql" -h "$work/sock" -p $port -U postgres -X -q -v ON_ERROR_STOP=1 "$@"; }

if [ -n "${MD_NEGATIVE:-}" ]; then
  mut=$work/new-mutated; rm -rf "$mut"; cp -r "$new" "$mut"
  f=$(grep -l "op_check" "$mut"/*.sql | head -1)
  sed -i "s/'schema_changed', 'node_truncate'))/'schema_changed', 'node_truncat3'))/" "$f"
  new=$mut
fi

apply() { # dir db schema
  local dir=$1 db=$2 s=$3
  psql_ -d postgres -c "create database $db" 
  psql_ -d "$db" -c "create schema \"$s\""
  for f in $(ls "$dir"/V*.sql | sort -V); do
    { echo "set search_path to \"$s\", public;"; echo begin\;; cat "$f"; echo; echo commit\;; } | psql_ -d "$db" >/dev/null
  done
}
dump() { # db schema outprefix
  local common=(-h "$work/sock" -p $port -U postgres --no-owner --no-privileges -n "$2" -T "$2.refinery_schema_history" "$1")
  { "$PGBIN/pg_dump" "${common[@]}" --schema-only; "$PGBIN/pg_dump" "${common[@]}" --data-only --inserts --rows-per-insert=1; } \
    | grep -vE '^\\(un)?restrict |^-- Dumped (from|by)' \
    | sed -E "s/'20[0-9]{2}-[0-9]{2}-[0-9]{2} [0-9:.]+[+-][0-9]{2}'/'<ts>'/g" > "$3"
}
rc=0
for s in tr_short trellis_instance_with_a_long_schema_name_for_truncation_abc; do
  [ "${#s}" -le 63 ] || exit 3
  db=$(echo "$s" | cut -c1-8)
  apply "$old" "old_$db" "$s"; apply "$new" "new_$db" "$s"
  dump "old_$db" "$s" "$work/out/old-$db.sql"; dump "new_$db" "$s" "$work/out/new-$db.sql"
  if diff -u "$work/out/old-$db.sql" "$work/out/new-$db.sql" > "$work/out/diff-$db.txt"; then
    echo "EQUIVALENT schema=$s (${#s} bytes, $(wc -l < "$work/out/old-$db.sql") dump lines)"
  else
    echo "DIFFERENT schema=$s"; cat "$work/out/diff-$db.txt"; rc=1
  fi
done
exit $rc
