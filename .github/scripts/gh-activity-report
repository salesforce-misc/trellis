#!/usr/bin/env python3
"""Fetch issue/PR activity from a repo and (re)generate a standalone HTML
report with charts of issues opened, issues closed, PRs merged, the open-issue
burndown (split into Next Release / Roadmap / Other buckets, replayed from each
issue's label history), and (optionally) validation logbook totals.

Usage: gh-activity-report [--repo OWNER/NAME] [--out-dir DIR]
                           [--logbook TSV_PATH | --logbook-json JSON_PATH]

Re-running does a full refresh (re-fetches every issue/PR and rewrites
data.json + report.html) rather than an incremental merge -- with a few
hundred issues/PRs this is fast, and it sidesteps the correctness bugs an
incremental merge invites (reopened issues, edited close dates, etc).

Runs in two contexts:
- On this box: reads the live validation logbook (local_docs/logbook.tsv,
  see .claude/scripts/logbook) directly, and writes to
  local_docs/github-activity/{data.json,report.html} by default.
- In the nightly GitHub Actions workflow (salesforce-misc/trellis): has no
  access to this box's logbook.tsv, so it takes a pre-aggregated snapshot via
  --logbook-json (published nightly from this box to a branch on the fork --
  see .claude/scripts/publish-dashboard-data) and writes to --out-dir for
  actions/upload-pages-artifact.
"""
import argparse
import csv
import json
import os
import subprocess
import sys
import time
from bisect import bisect_right
from collections import defaultdict
from datetime import date, datetime, timedelta, timezone

# Only the events that change what an issue counted as on a given day: label
# changes (the open-issue buckets) and close/reopen (whether it was open).
TIMELINE_ITEMS = """timelineItems(
        first: 100, %s
        itemTypes: [LABELED_EVENT, UNLABELED_EVENT, CLOSED_EVENT, REOPENED_EVENT]
      ) {
        pageInfo { hasNextPage endCursor }
        nodes {
          __typename
          ... on LabeledEvent { createdAt label { name } }
          ... on UnlabeledEvent { createdAt label { name } }
          ... on ClosedEvent { createdAt }
          ... on ReopenedEvent { createdAt }
        }
      }"""

ISSUES_QUERY = """
query($owner: String!, $name: String!, $after: String) {
  repository(owner: $owner, name: $name) {
    issues(first: 50, after: $after, orderBy: {field: CREATED_AT, direction: ASC}) {
      pageInfo { hasNextPage endCursor }
      nodes {
        number createdAt closedAt
        labels(first: 50) { nodes { name } }
        """ + TIMELINE_ITEMS % "" + """
      }
    }
  }
}
"""

# The rare issue with more than 100 label/close events gets its remaining
# events fetched one page at a time.
ISSUE_TIMELINE_QUERY = """
query($owner: String!, $name: String!, $number: Int!, $after: String) {
  repository(owner: $owner, name: $name) {
    issue(number: $number) {
      """ + TIMELINE_ITEMS % "after: $after," + """
    }
  }
}
"""

PRS_QUERY = """
query($owner: String!, $name: String!, $endCursor: String) {
  repository(owner: $owner, name: $name) {
    pullRequests(first: 100, after: $endCursor, orderBy: {field: CREATED_AT, direction: ASC}) {
      pageInfo { hasNextPage endCursor }
      nodes { createdAt mergedAt }
    }
  }
}
"""


def resolve_token() -> str:
    # SF_GH_TOKEN (this box's upstream credential) first, then whatever `gh`
    # itself would use (GH_TOKEN/GITHUB_TOKEN -- what a GitHub Actions runner
    # sets automatically), so the same script runs unmodified in CI.
    for var in ("SF_GH_TOKEN", "GH_TOKEN", "GITHUB_TOKEN"):
        token = os.environ.get(var)
        if token:
            return token
    # Per CLAUDE.md: load the full credential set if none of the above are
    # in the environment yet (only applies on this box, not in CI).
    env_file = os.path.expanduser("~/claude_env")
    if os.path.exists(env_file):
        result = subprocess.run(
            ["bash", "-c", f"set -a; source {env_file}; set +a; echo -n \"$SF_GH_TOKEN\""],
            capture_output=True,
            text=True,
        )
        token = result.stdout.strip()
        if token:
            return token
    sys.exit(
        "error: no SF_GH_TOKEN, GH_TOKEN or GITHUB_TOKEN in the environment, and "
        "~/claude_env didn't provide one either. This script needs repo access to "
        "read issues/PRs."
    )


def fetch_nodes(token: str, owner: str, name: str, query: str, jq_path: str) -> list[dict]:
    proc = subprocess.run(
        [
            "gh",
            "api",
            "graphql",
            "--paginate",
            "-f",
            f"query={query}",
            "-F",
            f"owner={owner}",
            "-F",
            f"name={name}",
            "--jq",
            jq_path,
        ],
        capture_output=True,
        text=True,
        env={**os.environ, "GH_TOKEN": token},
    )
    if proc.returncode != 0:
        sys.exit(f"error: gh api graphql failed:\n{proc.stderr}")
    # --jq applied per page emits one JSON node per line (NDJSON).
    return [json.loads(line) for line in proc.stdout.splitlines() if line.strip()]


def graphql(token: str, query: str, **variables) -> dict:
    """One GraphQL request through `gh`, retried with backoff: the network
    drops intermittently and a full refresh makes dozens of requests."""
    cmd = ["gh", "api", "graphql", "-f", f"query={query}"]
    for key, value in variables.items():
        if value is None:
            continue
        # -F types the value (needed for Int!); -f keeps strings raw.
        cmd += ["-F" if isinstance(value, int) else "-f", f"{key}={value}"]
    for delay in (0, 2, 4, 8, 16):
        time.sleep(delay)
        proc = subprocess.run(cmd, capture_output=True, text=True, env={**os.environ, "GH_TOKEN": token})
        if proc.returncode == 0:
            return json.loads(proc.stdout)
    sys.exit(f"error: gh api graphql failed:\n{proc.stderr}")


def fetch_issues(token: str, owner: str, name: str) -> list[dict]:
    """Every issue with its current labels and its label/close/reopen events
    (chronological), paginated by hand: `gh --paginate` can't follow the
    top-level cursor when the response has nested pageInfo too."""
    issues = []
    after = None
    while True:
        page = graphql(token, ISSUES_QUERY, owner=owner, name=name, after=after)["data"]["repository"]["issues"]
        for node in page["nodes"]:
            events = list(node["timelineItems"]["nodes"])
            more = node["timelineItems"]["pageInfo"]
            while more["hasNextPage"]:
                rest = graphql(
                    token, ISSUE_TIMELINE_QUERY, owner=owner, name=name,
                    number=node["number"], after=more["endCursor"],
                )["data"]["repository"]["issue"]["timelineItems"]
                events += rest["nodes"]
                more = rest["pageInfo"]
            issues.append({
                "number": node["number"],
                "createdAt": node["createdAt"],
                "closedAt": node["closedAt"],
                "labels": [l["name"] for l in node["labels"]["nodes"]],
                "events": events,
            })
        if not page["pageInfo"]["hasNextPage"]:
            return issues
        after = page["pageInfo"]["endCursor"]


LOCAL_TZ = datetime.now().astimezone().tzinfo


def parse_date(ts: str) -> date:
    # GitHub timestamps are UTC; bucket by the local calendar day so "today"
    # matches what a reader on this box actually sees as today, not whatever
    # day UTC happens to be at the moment.
    utc_dt = datetime.strptime(ts, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    return utc_dt.astimezone(LOCAL_TZ).date()


# Open-issue buckets. An issue counts in exactly one, by its labels:
#   next_release  has "Next Release" (must close before the release)
#   roadmap       else has "low priority" or "Research" (brainstorm/long-term)
#   other         everything else
# Label names are matched case-insensitively.
BUCKETS = ("next_release", "roadmap", "other")
NEXT_RELEASE_LABEL = "next release"
ROADMAP_LABELS = {"low priority", "research"}


def bucket_for(labels: set[str]) -> str:
    if NEXT_RELEASE_LABEL in labels:
        return "next_release"
    if labels & ROADMAP_LABELS:
        return "roadmap"
    return "other"


def parse_utc(ts: str) -> datetime:
    return datetime.strptime(ts, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)


def issue_states(issue: dict) -> list[tuple[datetime, str | None]]:
    """Replays an issue's label and close/reopen events into
    [(when, bucket)], one entry per change in order: the bucket it counts in
    from `when` on, or None while it is closed."""
    labels: set[str] = set()
    is_open = True
    states = [(parse_utc(issue["createdAt"]), bucket_for(labels))]
    for event in sorted(issue["events"], key=lambda e: e["createdAt"]):
        kind = event["__typename"]
        name = (event.get("label") or {}).get("name", "").lower()
        if kind == "LabeledEvent" and name:
            labels.add(name)
        elif kind == "UnlabeledEvent" and name:
            labels.discard(name)
        elif kind == "ClosedEvent":
            is_open = False
        elif kind == "ReopenedEvent":
            is_open = True
        states.append((parse_utc(event["createdAt"]), bucket_for(labels) if is_open else None))
    return states


def open_issue_buckets(issues: list[dict], days: list[date]) -> dict[date, dict[str, int]]:
    """For each day, how many issues were open in each bucket as of the start
    of that day (local midnight): an issue that gains or loses a label, closes
    or reopens during the day moves on the next day's count, and one opened
    today first counts tomorrow."""
    starts = [datetime.combine(d, datetime.min.time(), tzinfo=LOCAL_TZ).astimezone(timezone.utc) for d in days]
    counts = {d: dict.fromkeys(BUCKETS, 0) for d in days}
    for issue in issues:
        states = issue_states(issue)
        times = [when for when, _ in states]
        for d, start in zip(days, starts):
            i = bisect_right(times, start) - 1
            if i >= 0 and states[i][1] is not None:
                counts[d][states[i][1]] += 1
    return counts


def replay_mismatches(issues: list[dict]) -> list[int]:
    """Numbers of issues whose replayed latest state disagrees with their
    current labels/open state (e.g. an event for a since-deleted label), so a
    drifting backfill is reported instead of silently charted."""
    bad = []
    for issue in issues:
        current = None if issue["closedAt"] else bucket_for({l.lower() for l in issue["labels"]})
        if issue_states(issue)[-1][1] != current:
            bad.append(issue["number"])
    return bad


def aggregate(issues: list[dict], prs: list[dict]) -> list[dict]:
    opened_issues = defaultdict(int)
    closed_issues = defaultdict(int)
    merged_prs = defaultdict(int)
    seen_dates = set()

    for issue in issues:
        d = parse_date(issue["createdAt"])
        opened_issues[d] += 1
        seen_dates.add(d)
        if issue.get("closedAt"):
            cd = parse_date(issue["closedAt"])
            closed_issues[cd] += 1
            seen_dates.add(cd)

    for pr in prs:
        d = parse_date(pr["createdAt"])
        seen_dates.add(d)
        if pr.get("mergedAt"):
            md = parse_date(pr["mergedAt"])
            merged_prs[md] += 1
            seen_dates.add(md)

    if not seen_dates:
        return []

    start = min(seen_dates)
    end = max(max(seen_dates), datetime.now(LOCAL_TZ).date())

    dates = [start + timedelta(days=n) for n in range((end - start).days + 1)]
    open_by_bucket = open_issue_buckets(issues, dates)
    return [
        {
            "date": d.isoformat(),
            "opened_issues": opened_issues.get(d, 0),
            "closed_issues": closed_issues.get(d, 0),
            "merged_prs": merged_prs.get(d, 0),
            "open_next_release": open_by_bucket[d]["next_release"],
            "open_roadmap": open_by_bucket[d]["roadmap"],
            "open_other": open_by_bucket[d]["other"],
            "open_issues_total": sum(open_by_bucket[d].values()),
        }
        for d in dates
    ]


def read_logbook(path: str) -> list[dict]:
    """Parse local_docs/logbook.tsv (see .claude/scripts/logbook and the
    eng-manager skill's "Validation logbook" section). Only "done" rows carry
    a finished_at/duration/rows; a "running" reservation (not yet finished)
    is skipped."""
    if not os.path.exists(path):
        return []
    with open(path, newline="") as f:
        rows = list(csv.DictReader(f, delimiter="\t"))
    return [r for r in rows if r.get("state") == "done" and r.get("finished_at")]


def aggregate_logbook(entries: list[dict]) -> list[dict]:
    runs = defaultdict(int)
    hours = defaultdict(float)
    rows_validated = defaultdict(int)
    seen_dates = set()

    for entry in entries:
        # finished_at already carries its own UTC offset (e.g. -07:00), so its
        # calendar date is the local day the run actually finished on.
        d = datetime.fromisoformat(entry["finished_at"]).date()
        runs[d] += 1
        hours[d] += int(entry["duration_s"]) / 3600
        rows_validated[d] += int(entry["rows"])
        seen_dates.add(d)

    if not seen_dates:
        return []

    start = min(seen_dates)
    end = max(max(seen_dates), datetime.now(LOCAL_TZ).date())

    days = []
    d = start
    while d <= end:
        days.append(
            {
                "date": d.isoformat(),
                "runs": runs.get(d, 0),
                "hours": round(hours.get(d, 0.0), 2),
                "rows_validated": rows_validated.get(d, 0),
            }
        )
        d += timedelta(days=1)
    return days


