  <div class="empty-state" id="logbookEmpty" hidden>No validation runs recorded yet.</div>

  <button class="table-toggle" id="logbookTableToggle" type="button">View as table</button>
  <div class="table-wrap" id="logbookTableWrap" hidden>
    <table id="logbookTable">
      <thead><tr><th>Date</th><th>Runs</th><th>Hours</th><th>Rows validated</th></tr></thead>
      <tbody id="logbookTableBody"></tbody>
    </table>
  </div>
</div>

<script type="application/json" id="activity-data">{data_json}</script>
<script type="application/json" id="logbook-data">{logbook_json}</script>
<script>
(function () {{
  "use strict";
  var GITHUB_SERIES = [
    {{ key: "opened_issues", name: "Issues opened", color: "var(--series-1)" }},
    {{ key: "closed_issues", name: "Issues closed", color: "var(--series-2)" }},
    {{ key: "merged_prs", name: "PRs merged", color: "var(--series-3)" }}
  ];
  // Total is neutral; the three buckets take the fixed categorical order.
  var BURNDOWN_SERIES = [
    {{ key: "open_issues_total", name: "Total", color: "var(--text-secondary)" }},
    {{ key: "open_next_release", name: "Next Release", color: "var(--series-1)" }},
    {{ key: "open_roadmap", name: "Roadmap", color: "var(--series-2)" }},
    {{ key: "open_other", name: "Other", color: "var(--series-3)" }}
  ];
  var LOGBOOK_SERIES = {{
    runs: {{ key: "runs", name: "Validation runs", color: "var(--series-1)", format: function (v) {{ return String(v); }} }},
    hours: {{ key: "hours", name: "Hours spent validating", color: "var(--series-1)", format: function (v) {{ return v.toFixed(1) + "h"; }} }},
    rows_validated: {{ key: "rows_validated", name: "Rows validated", color: "var(--series-1)", format: function (v) {{ return Math.round(v).toLocaleString(); }} }}
  }};
  var ALL_DAYS = JSON.parse(document.getElementById("activity-data").textContent);
  var ALL_LOGBOOK_DAYS = JSON.parse(document.getElementById("logbook-data").textContent);

  var state = {{ range: "all", granularity: "day" }};
  var svgNS = "http://www.w3.org/2000/svg";

  function isoWeekStart(d) {{
    var date = new Date(d + "T00:00:00Z");
    var day = (date.getUTCDay() + 6) % 7; // Monday = 0
    date.setUTCDate(date.getUTCDate() - day);
    return date.toISOString().slice(0, 10);
  }}

  function filterByRange(days) {{
    if (state.range === "all") return days;
    var n = parseInt(state.range, 10);
    return days.slice(Math.max(0, days.length - n));
  }}

  // Buckets daily rows into ISO weeks. `specs` is [{{ key, mode }}]; "sum" adds
  // across the week (counts), "last" keeps the final day's value (running
  // totals like open-issue count, where summing would be meaningless).
  function bucketByGranularity(days, specs) {{
    if (state.granularity === "day") return days;
    var buckets = {{}};
    var order = [];
    days.forEach(function (d) {{
      var weekKey = isoWeekStart(d.date);
      if (!buckets[weekKey]) {{
        var zeroed = {{ date: weekKey }};
        specs.forEach(function (spec) {{ zeroed[spec.key] = spec.mode === "sum" ? 0 : null; }});
        buckets[weekKey] = zeroed;
        order.push(weekKey);
      }}
      specs.forEach(function (spec) {{
        if (spec.mode === "sum") buckets[weekKey][spec.key] += d[spec.key];
        else buckets[weekKey][spec.key] = d[spec.key];
      }});
    }});
    return order.map(function (k) {{ return buckets[k]; }});
  }}

  function niceMax(value) {{
    if (value <= 0) return 1;
    var magnitude = Math.pow(10, Math.floor(Math.log10(value)));
    var normalized = value / magnitude;
    var step = normalized <= 1 ? 1 : normalized <= 2 ? 2 : normalized <= 5 ? 5 : 10;
    return step * magnitude;
  }}

  // Compact y-axis tick label: 950, 2.5k, 40M, 3B, 1.2T, then 1e15 / 2.5e21
  // beyond T, so a tick never needs a long run of zeros.
  function formatAxisValue(v) {{
    if (v === 0) return "0";
    var sign = v < 0 ? "-" : "";
    var abs = Math.abs(v);
    // toPrecision(3) + Number() drops float noise and trailing zeros without
    // rounding a fractional tick like 0.5 or 2.5 up to a whole number.
    var trim = function (n) {{ return String(Number(n.toPrecision(3))); }};
    if (abs < 1e3) return sign + trim(abs);
    if (abs >= 1e15) {{
      var parts = abs.toExponential().split("e");
      return sign + trim(Number(parts[0])) + "e" + parseInt(parts[1], 10);
    }}
    var units = [[1e12, "T"], [1e9, "B"], [1e6, "M"], [1e3, "k"]];
    for (var i = 0; i < units.length; i++) {{
      if (abs >= units[i][0]) return sign + trim(abs / units[i][0]) + units[i][1];
    }}
  }}

  function el(tag, attrs) {{
    var node = document.createElementNS(svgNS, tag);
    for (var k in attrs) node.setAttribute(k, attrs[k]);
    return node;
  }}

  function formatDateLabel(iso) {{
    var d = new Date(iso + "T00:00:00Z");
    return d.toLocaleDateString(undefined, {{ month: "short", day: "numeric", timeZone: "UTC" }});
  }}

  // Builds a renderer bound to one <svg>/legend/tooltip triple. `series` is
  // one or more {{ key, name, color, format? }} definitions; a single series
  // gets no legend (the panel title already names it) and a terser end-label.
  // Clicking a legend item isolates the chart to just that series (click
  // again to restore all).
  function makeChartRenderer(chart, legend, tooltip, opts) {{
    var W = opts.W, H = opts.H, PAD = opts.PAD;
    var isolatedKey = null;

    return function renderChart(days, series) {{
      chart.innerHTML = "";
      if (legend) legend.innerHTML = "";

      if (legend && series.length >= 2) {{
        series.forEach(function (s) {{
          var item = document.createElement("div");
          item.className = "item" + (isolatedKey && isolatedKey !== s.key ? " dimmed" : "");
          item.setAttribute("role", "button");
          item.setAttribute("tabindex", "0");
          item.setAttribute("aria-pressed", String(isolatedKey === s.key));
          var swatch = document.createElement("span");
          swatch.className = "swatch";
          swatch.style.background = s.color;
          var label = document.createElement("span");
          label.textContent = s.name;
          item.appendChild(swatch);
          item.appendChild(label);
          var isolate = function () {{
            isolatedKey = (isolatedKey === s.key) ? null : s.key;
            renderChart(days, series);
          }};
          item.addEventListener("click", isolate);
          item.addEventListener("keydown", function (evt) {{
            if (evt.key === "Enter" || evt.key === " ") {{ evt.preventDefault(); isolate(); }}
          }});
          legend.appendChild(item);
        }});
      }}

      if (days.length === 0) return;

      var visible = isolatedKey ? series.filter(function (s) {{ return s.key === isolatedKey; }}) : series;
      var format = function (s, v) {{ return s.format ? s.format(v) : String(v); }};

      var maxValue = 0;
      days.forEach(function (d) {{
        visible.forEach(function (s) {{ maxValue = Math.max(maxValue, d[s.key]); }});
      }});
      var yMax = niceMax(maxValue);
      var plotW = W - PAD.left - PAD.right;
      var plotH = H - PAD.top - PAD.bottom;

      function x(i) {{
        return days.length === 1 ? PAD.left : PAD.left + (i / (days.length - 1)) * plotW;
      }}
      function y(v) {{
        return PAD.top + plotH - (v / yMax) * plotH;
      }}

      // Gridlines + y ticks (0, mid, max)
      [0, 0.5, 1].forEach(function (frac) {{
        var value = yMax * frac;
        var gy = y(value);
        chart.appendChild(el("line", {{
          x1: PAD.left, x2: W - PAD.right, y1: gy, y2: gy,
          class: frac === 0 ? "baseline" : "gridline"
        }}));
        var label = el("text", {{ x: PAD.left - 8, y: gy + 4, class: "axis-label", "text-anchor": "end" }});
        label.textContent = formatAxisValue(value);
        chart.appendChild(label);
      }});

      // X-axis ticks: a handful evenly spaced, scaled to the chart's width
      var tickCount = Math.min(days.length, Math.max(4, Math.round(W / 150)));
      for (var t = 0; t < tickCount; t++) {{
        var idx = tickCount === 1 ? 0 : Math.round((t / (tickCount - 1)) * (days.length - 1));
        var tx = x(idx);
        var label = el("text", {{ x: tx, y: H - PAD.bottom + 16, class: "axis-label", "text-anchor": "middle" }});
        label.textContent = formatDateLabel(days[idx].date);
        chart.appendChild(label);
      }}

      // Lines + end markers + end labels (stacked by value order to avoid overlap)
      var ends = visible.map(function (s) {{
        var last = days[days.length - 1];
        return {{ s: s, value: last[s.key], py: y(last[s.key]) }};
      }}).sort(function (a, b) {{ return a.py - b.py; }});
      for (var e = 1; e < ends.length; e++) {{
        if (ends[e].py - ends[e - 1].py < 12) ends[e].py = ends[e - 1].py + 12;
      }}

      visible.forEach(function (s) {{
        var points = days.map(function (d, i) {{ return x(i) + "," + y(d[s.key]); }}).join(" ");
        chart.appendChild(el("polyline", {{ points: points, class: "series-line", style: "stroke:" + s.color }}));

        var lastIdx = days.length - 1;
        var lx = x(lastIdx), ly = y(days[lastIdx][s.key]);
        chart.appendChild(el("circle", {{ cx: lx, cy: ly, r: 6, class: "end-dot-ring" }}));
        chart.appendChild(el("circle", {{ cx: lx, cy: ly, r: 4, style: "fill:" + s.color }}));
      }});
      ends.forEach(function (end) {{
        var label = el("text", {{
          x: x(days.length - 1) + 10, y: end.py + 4, class: "end-label", style: "fill:" + end.s.color
        }});
        label.textContent = series.length >= 2
          ? end.s.name + " " + format(end.s, end.value)
          : format(end.s, end.value);
        chart.appendChild(label);
      }});

      // Hover layer: crosshair + tooltip
      var hoverTarget = el("rect", {{
        x: PAD.left, y: PAD.top, width: plotW, height: plotH, class: "hover-target"
      }});
      var crosshair = el("line", {{ x1: 0, x2: 0, y1: PAD.top, y2: H - PAD.bottom, class: "crosshair" }});
      crosshair.style.display = "none";
      chart.appendChild(crosshair);
      chart.appendChild(hoverTarget);

      function nearestIndex(mouseX) {{
        if (days.length === 1) return 0;
        var frac = (mouseX - PAD.left) / plotW;
        var idx = Math.round(frac * (days.length - 1));
        return Math.max(0, Math.min(days.length - 1, idx));
      }}

      hoverTarget.addEventListener("pointermove", function (evt) {{
        var rect = chart.getBoundingClientRect();
        var scaleX = W / rect.width;
        var mouseX = (evt.clientX - rect.left) * scaleX;
        var idx = nearestIndex(mouseX);
        var d = days[idx];
        var cx = x(idx);
        crosshair.setAttribute("x1", cx);
        crosshair.setAttribute("x2", cx);
        crosshair.style.display = "block";

        tooltip.innerHTML = "";
        var dateRow = document.createElement("div");
        dateRow.className = "date";
        dateRow.textContent = d.date;
        tooltip.appendChild(dateRow);
        visible.forEach(function (s) {{
          var row = document.createElement("div");
          row.className = "row";
          var key = document.createElement("span");
          key.className = "key";
          key.style.background = s.color;
          var value = document.createElement("span");
          value.className = "value";
          value.textContent = format(s, d[s.key]);
          var name = document.createElement("span");
          name.className = "name";
          name.textContent = s.name;
          row.appendChild(key);
          row.appendChild(value);
          row.appendChild(name);
          tooltip.appendChild(row);
        }});
        tooltip.hidden = false;
        var cardRect = chart.parentElement.getBoundingClientRect();
        var left = evt.clientX - cardRect.left + 16;
        var top2 = evt.clientY - cardRect.top - 12;
        if (left + 160 > cardRect.width) left = evt.clientX - cardRect.left - 176;
        tooltip.style.left = left + "px";
        tooltip.style.top = top2 + "px";
      }});
      hoverTarget.addEventListener("pointerleave", function () {{
        crosshair.style.display = "none";
        tooltip.hidden = true;
      }});
    }};
  }}

  var renderGithubChart = makeChartRenderer(
    document.getElementById("chart"),
    document.getElementById("legend"),
    document.getElementById("tooltip"),
    {{ W: 900, H: 320, PAD: {{ top: 12, right: 16, bottom: 28, left: 36 }} }}
  );
  var renderBurndownChart = makeChartRenderer(
    document.getElementById("burndownChart"), document.getElementById("burndownLegend"),
    document.getElementById("burndownTooltip"),
    {{ W: 900, H: 240, PAD: {{ top: 12, right: 110, bottom: 28, left: 48 }} }}
  );
  var miniOpts = {{ W: 280, H: 170, PAD: {{ top: 10, right: 12, bottom: 24, left: 40 }} }};
  var renderLogbookRuns = makeChartRenderer(
    document.getElementById("logbookRunsChart"), null, document.getElementById("logbookRunsTooltip"), miniOpts
  );
  var renderLogbookHours = makeChartRenderer(
    document.getElementById("logbookHoursChart"), null, document.getElementById("logbookHoursTooltip"), miniOpts
  );
  var renderLogbookRows = makeChartRenderer(
    document.getElementById("logbookRowsChart"), null, document.getElementById("logbookRowsTooltip"), miniOpts
  );

  function renderGithubTable(days) {{
    var tableBody = document.getElementById("tableBody");
    tableBody.innerHTML = "";
    days.forEach(function (d) {{
      var tr = document.createElement("tr");
      [d.date, d.opened_issues, d.closed_issues, d.merged_prs].forEach(function (v) {{
        var td = document.createElement("td");
        td.textContent = String(v);
        tr.appendChild(td);
      }});
      tableBody.appendChild(tr);
    }});
  }}

  function renderBurndownTable(days) {{
    var tableBody = document.getElementById("burndownTableBody");
    tableBody.innerHTML = "";
    days.forEach(function (d) {{
      var tr = document.createElement("tr");
      [d.date, d.open_issues_total, d.open_next_release, d.open_roadmap, d.open_other].forEach(function (v) {{
        var td = document.createElement("td");
        td.textContent = String(v);
        tr.appendChild(td);
      }});
      tableBody.appendChild(tr);
    }});
  }}

  function renderLogbookTable(days) {{
    var tableBody = document.getElementById("logbookTableBody");
    tableBody.innerHTML = "";
    days.forEach(function (d) {{
      var tr = document.createElement("tr");
      [d.date, d.runs, d.hours.toFixed(1), d.rows_validated.toLocaleString()].forEach(function (v) {{
        var td = document.createElement("td");
        td.textContent = String(v);
        tr.appendChild(td);
      }});
      tableBody.appendChild(tr);
    }});
  }}

  // Totals over the days in the selected range (so "All" is the all-time
  // total). Summed before weekly bucketing; bucketing doesn't change a sum.
  function renderLogbookTotals(days) {{
    var caption = state.range === "all" ? "Total, all time" : "Total, last " + state.range + " days";
    var sum = function (key) {{
      return days.reduce(function (acc, d) {{ return acc + d[key]; }}, 0);
    }};
    var oneDecimal = {{ minimumFractionDigits: 1, maximumFractionDigits: 1 }};
    var totals = [
      ["logbookRunsTotal", sum("runs").toLocaleString()],
      ["logbookHoursTotal", sum("hours").toLocaleString(undefined, oneDecimal) + " h"],
      ["logbookRowsTotal", Math.round(sum("rows_validated")).toLocaleString()]
    ];
    totals.forEach(function (t) {{
      var box = document.getElementById(t[0]);
      box.innerHTML = "";
      var value = document.createElement("div");
      value.className = "value";
      value.textContent = t[1];
      var cap = document.createElement("div");
      cap.className = "caption";
      cap.textContent = caption;
      box.appendChild(value);
      box.appendChild(cap);
    }});
  }}

  function render() {{
    var githubDays = bucketByGranularity(filterByRange(ALL_DAYS), [
      {{ key: "opened_issues", mode: "sum" }},
      {{ key: "closed_issues", mode: "sum" }},
      {{ key: "merged_prs", mode: "sum" }},
      {{ key: "open_issues_total", mode: "last" }},
      {{ key: "open_next_release", mode: "last" }},
      {{ key: "open_roadmap", mode: "last" }},
      {{ key: "open_other", mode: "last" }}
    ]);
    renderGithubChart(githubDays, GITHUB_SERIES);
    renderGithubTable(githubDays);
    renderBurndownChart(githubDays, BURNDOWN_SERIES);
    renderBurndownTable(githubDays);

    var logbookRangeDays = filterByRange(ALL_LOGBOOK_DAYS);
    var logbookDays = bucketByGranularity(logbookRangeDays, [
      {{ key: "runs", mode: "sum" }},
      {{ key: "hours", mode: "sum" }},
      {{ key: "rows_validated", mode: "sum" }}
    ]);
    var hasLogbookData = logbookDays.length > 0;
    document.getElementById("logbookGrid").hidden = !hasLogbookData;
    document.getElementById("logbookEmpty").hidden = hasLogbookData;
    document.getElementById("logbookTableToggle").hidden = !hasLogbookData;
    if (hasLogbookData) {{
      renderLogbookTotals(logbookRangeDays);
      renderLogbookRuns(logbookDays, [LOGBOOK_SERIES.runs]);
      renderLogbookHours(logbookDays, [LOGBOOK_SERIES.hours]);
      renderLogbookRows(logbookDays, [LOGBOOK_SERIES.rows_validated]);
      renderLogbookTable(logbookDays);
    }}
  }}

  document.getElementById("rangeGroup").addEventListener("click", function (evt) {{
    var btn = evt.target.closest("button[data-range]");
    if (!btn) return;
    state.range = btn.getAttribute("data-range");
    this.querySelectorAll("button").forEach(function (b) {{ b.setAttribute("aria-pressed", String(b === btn)); }});
    render();
  }});
  document.getElementById("granularityGroup").addEventListener("click", function (evt) {{
    var btn = evt.target.closest("button[data-granularity]");
    if (!btn) return;
    state.granularity = btn.getAttribute("data-granularity");
    this.querySelectorAll("button").forEach(function (b) {{ b.setAttribute("aria-pressed", String(b === btn)); }});
    render();
  }});
  document.getElementById("tableToggle").addEventListener("click", function () {{
    var wrap = document.getElementById("tableWrap");
    wrap.hidden = !wrap.hidden;
    this.textContent = wrap.hidden ? "View as table" : "Hide table";
  }});
  document.getElementById("burndownTableToggle").addEventListener("click", function () {{
    var wrap = document.getElementById("burndownTableWrap");
    wrap.hidden = !wrap.hidden;
    this.textContent = wrap.hidden ? "View as table" : "Hide table";
  }});
  document.getElementById("logbookTableToggle").addEventListener("click", function () {{
    var wrap = document.getElementById("logbookTableWrap");
    wrap.hidden = !wrap.hidden;
    this.textContent = wrap.hidden ? "View as table" : "Hide table";
  }});
  document.getElementById("themeToggle").addEventListener("click", function () {{
    var root = document.documentElement;
    var current = root.getAttribute("data-theme");
    var next = current === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
  }});

  render();
}})();
</script>
</body>
</html>
"""


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", default="salesforce-misc/trellis", help="owner/name to report on")
    parser.add_argument(
        "--out-dir",
        default=None,
        help="output directory (default: local_docs/github-activity under the repo root)",
    )
    parser.add_argument(
        "--logbook",
        default=None,
        help="path to the validation logbook TSV (default: local_docs/logbook.tsv under the repo root)",
    )
    parser.add_argument(
        "--logbook-json",
        default=None,
        help=(
            "path to a pre-aggregated logbook snapshot (the same per-day shape this "
            "script writes to data.json's logbook_days) -- for environments like CI "
            "that have no access to the live logbook.tsv. Takes priority over --logbook."
        ),
    )
    args = parser.parse_args()

    owner, name = args.repo.split("/", 1)

    def repo_root() -> str:
        # Only shelled out to when an output/logbook path is left to default
        # -- in CI, $GITHUB_WORKSPACE isn't itself a git repo (the checkout
        # lives in a subdirectory), and both paths are always given there.
        return subprocess.run(
            ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True
        ).stdout.strip()

    out_dir = args.out_dir or os.path.join(repo_root(), "local_docs", "github-activity")
    os.makedirs(out_dir, exist_ok=True)

    token = resolve_token()

    print(f"Fetching issues from {args.repo}...")
    issues = fetch_issues(token, owner, name)
    print(f"Fetching pull requests from {args.repo}...")
    prs = fetch_nodes(token, owner, name, PRS_QUERY, ".data.repository.pullRequests.nodes[]")

    days = aggregate(issues, prs)

    if args.logbook_json:
        with open(args.logbook_json) as f:
            logbook_days = json.load(f)
        logbook_run_count = sum(d["runs"] for d in logbook_days)
    else:
        logbook_path = args.logbook or os.path.join(repo_root(), "local_docs", "logbook.tsv")
        logbook_entries = read_logbook(logbook_path)
        logbook_days = aggregate_logbook(logbook_entries)
        logbook_run_count = len(logbook_entries)

    generated_at = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    tz_label = datetime.now(LOCAL_TZ).strftime("%Z")

    data = {
        "repo": args.repo,
        "generated_at": generated_at,
        "timezone": tz_label,
        "days": days,
        "logbook_days": logbook_days,
    }

    data_path = os.path.join(out_dir, "data.json")
    with open(data_path, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")

    html = HTML_TEMPLATE.format(
        repo=args.repo,
        generated_at=generated_at,
        tz_label=tz_label,
        data_json=json.dumps(days),
        logbook_json=json.dumps(logbook_days),
    )
    report_path = os.path.join(out_dir, "report.html")
    with open(report_path, "w") as f:
        f.write(html)

    print(f"{len(issues)} issues, {len(prs)} PRs, {len(days)} days of activity")
    mismatches = replay_mismatches(issues)
    if mismatches:
        print(f"warning: replayed label history disagrees with current state for {len(mismatches)} issues: {mismatches[:20]}")
    print(f"{logbook_run_count} logbook runs, {len(logbook_days)} days of validation history")
    print(f"Wrote {data_path}")
    print(f"Wrote {report_path}")


if __name__ == "__main__":
    main()
